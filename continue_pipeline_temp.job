#!/bin/bash
#SBATCH --job-name=FEATHER_continue
#SBATCH --output=FEATHER_continue-%j.out
#SBATCH --error=FEATHER_continue-%j.err
#SBATCH --partition=scavenge
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=12:00:00

set -e

cd "$SLURM_SUBMIT_DIR"

source /opt/itu/easybuild/software/Anaconda3/2025.06-1/etc/profile.d/conda.sh
conda activate feather

echo "=========================================="
echo "Continuing FEATHER pipeline"
echo "Job ID: $SLURM_JOB_ID"
echo "Working directory: $(pwd)"
echo "Started: $(date)"
echo "=========================================="

echo
echo "1/3 - Creating remaining embedding variants"
python -u pipeline/embedding_variants.py

echo
echo "2/3 - Creating graph-level features"
python -u pipeline/graph_feature_calculation.py

echo
echo "3/3 - Running classification"
python -u supervised_learning/classification.py

echo
echo "Creating result archive"

tar -czf FEATHER_results_${SLURM_JOB_ID}.tar.gz \
  --exclude='output/FEATHER_embeddings/*/*.csv' \
  --exclude='output/POI_distances/*/*.csv' \
  output

echo
echo "Archive:"
ls -lh FEATHER_results_${SLURM_JOB_ID}.tar.gz

echo
echo "Pipeline continuation finished successfully: $(date)"